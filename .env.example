# Copy to .env and adjust. Nested settings use a double underscore.

VOXLAB__STT__PROVIDER=echo
VOXLAB__STT__MODEL=large-v3
VOXLAB__STT__DEVICE=cuda
VOXLAB__STT__COMPUTE_TYPE=float16
VOXLAB__STT__LANGUAGE=de

VOXLAB__LLM__PROVIDER=static
VOXLAB__LLM__MODEL=qwen3:8b
VOXLAB__LLM__BASE_URL=http://127.0.0.1:11434
VOXLAB__LLM__TEMPERATURE=0.3

VOXLAB__TTS__PROVIDER=silent
VOXLAB__TTS__MODEL=qwen3-tts
VOXLAB__TTS__VOICE=de-default
VOXLAB__TTS__DEVICE=cuda
# Set when Qwen3-TTS runs as a separate HTTP service (see docs/ARCHITECTURE.md).
# VOXLAB__TTS__BASE_URL=http://127.0.0.1:8080

VOXLAB__TRANSPORT=null
